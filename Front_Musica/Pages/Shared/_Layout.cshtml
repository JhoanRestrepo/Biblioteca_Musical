<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BM</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Front_Musica.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">ENGEL</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Música
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-page="/Ventanas/Albumes">Albumes</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Artistas">Artistas</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Canciones">Canciones</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Compositores">Compositores</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Generos">Generos</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Favoritos">Favoritos</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Fav_Canciones">Fav_Canciones</a></li>
                    </ul>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Relaciones y Control
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-page="/Ventanas/Albumes_Artistas">Albumes_Artistas</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Artistas_Sellos">Artistas_Sellos</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Canciones_Compositores">Canciones_Compositores</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Canciones_Generos">Canciones_Generos</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Canciones_Idiomas">Canciones_Idiomas</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Usuarios">Usuarios</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Auditorias">Auditorias</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Roles">Roles</a></li>
                        <li><a class="dropdown-item" asp-page="/Ventanas/Permisos">Permisos</a></li>
                    </ul>
                </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Front_Musica - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
