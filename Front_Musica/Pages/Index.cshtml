@page
@model IndexModel
@{
    ViewData["Title"] = "Biblioteca Musical";
}

<div class="text-center">
    <h1 class="display-4">Biblioteca Musical</h1>
</div>
@if (!string.IsNullOrEmpty(Model.MensajeEstado))
{
    <div class="alert alert-info mt-3" style="width:60%">
        @Model.MensajeEstado
    </div>
}
@if (!Model.EstaLogueado)
{
    if (!Model.MostrarRegistro)
    {
        <div class="container" align="left" style="width:100%">
            <h3>Login</h3>

            <form method="POST">
                <div style="width:60%">
                    <div class="form-group mb-2">
                        <label class="control-label">Usuario:</label>
                        <input onchange="keyUp(this)" asp-for="@Model.Email" class="form-control" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Contraseña:</label>
                        <input type="password" onchange="keyUp(this)" asp-for="@Model.Contraseña" class="form-control" />
                    </div>

                    <input type="submit" value="Entrar" asp-page-handler="BtEnter" class="btn btn-secondary" />
                    <input type="submit" value="Limpiar" asp-page-handler="BtClean" class="btn btn-secondary" />
                    <input type="submit" value="Crear usuario" asp-page-handler="BtMostrarRegistro" class="btn btn-outline-secondary" />
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="container" align="left" style="width:100%">
            <h3>Crear usuario</h3>

            <form method="POST">
                <div style="width:60%">
                    <div class="form-group mb-2">
                        <label class="control-label">Nombre:</label>
                        <input asp-for="@Model.NuevoNombre" class="form-control" />
                    </div>
                    <div class="form-group mb-2">
                        <label class="control-label">Apellido:</label>
                        <input asp-for="@Model.NuevoApellido" class="form-control" />
                    </div>
                    <div class="form-group mb-2">
                        <label class="control-label">Correo:</label>
                        <input asp-for="@Model.NuevoCorreo" class="form-control" />
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Contraseña:</label>
                        <input type="password" asp-for="@Model.NuevaContraseña" class="form-control" />
                    </div>

                    <input type="submit" value="Registrar" asp-page-handler="BtRegistrar" class="btn btn-secondary" />
                    <input type="submit" value="Volver al Login" asp-page-handler="BtVolverLogin" class="btn btn-outline-secondary" />
                </div>
            </form>
        </div>
    }
}
else
{
    <div class="text-center">
        <h1 class="display-4">
            Bienvenido
        </h1>

        <form method="POST">
            <input type="submit"
                   value="Cerrar"
                   asp-page-handler="BtClose"
                   class="btn btn-default" />
        </form>
    </div>
}
<p>By: Jhoan Restrepo, Melisa Pino y Roveiro Osorio</p>