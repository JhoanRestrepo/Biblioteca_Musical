@page
@model PermisosModel
@{
    ViewData["Title"] = "Permisos";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Permisos</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar"/>
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo"/>
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar"/>
            <input id="flNombre"
                   placeholder="Nombre"
                   asp-for="@Model.Filtro!.Nombre"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Permiso</h3>

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                       asp-for="@Model.Actual!.Nombre" />
                <br />

                <label>
                    Codigo
                </label>
                <input id="nmCodigo"
                       asp-for="@Model.Actual!.Codigo" />
                <br />

                <label>
                    Descripcion
                </label>
                <input id="nmDescripcion"
                       asp-for="@Model.Actual!.Descripcion" />
                <br />
                
            </div>
        }
        
        @if (Model.Nuevo)
        {
            <div>
                <h3>Permiso</h3>
                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                       asp-for="@Model.Actual!.Nombre" />
                <br />
                <label>
                    Codigo
                </label>
                <input id="nmCodigo"
                       asp-for="@Model.Actual!.Codigo" />
                <br />
               <label>
                    Descripcion
                </label>
                <input id="nmDescripcion"
                       asp-for="@Model.Actual!.Descripcion" />
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Permiso con información
                        @Model.Actual!.Nombre,
                        @Model.Actual!.Descripcion
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre</th>
                        <th>Codigo</th>
                        <th>Descripcion</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Codigo</td>
                                <td>@elemento.Descripcion</td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>