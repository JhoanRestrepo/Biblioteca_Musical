@page
@model SuscripcionesModel
@{
    ViewData["Title"] = "Suscripciones";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Suscripciones</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar"/>
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo"/>
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar"/>
            <input id="flUsuario"
                   placeholder="Usuario"
                   asp-for="@Model.Filtro!.Usuario"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Suscripcion</h3>

                <label>
                    Usuario
                </label>
                <input id="nmUsuario"
                       asp-for="@Model.Actual!.Usuario" />
                <br />

                <label>
                    Tipo_Plan
                </label>
                <input id="nmTipo_Plan"
                       asp-for="@Model.Actual!.Tipo_Plan" />
                <br />

                <label>
                    Fecha_Incio
                </label>
                <input id="nmFecha_Inicio"
                       asp-for="@Model.Actual!.Fecha_Inicio" />
                <br />
                <label>
                    Fecha_Fin
                </label>
                <input id="nmFecha_Fin"
                       asp-for="@Model.Actual!.Fecha_Fin" />
                <br />

            </div>
        }
        
        @if (Model.Nuevo)
        {
            <div>
                <h3>Suscripcion</h3>
                <label>
                    Usuario
                </label>
                <input id="nmUsuario"
                       asp-for="@Model.Actual!.Usuario" />
                <br />
                <label>
                    Tipo_Plan
                </label>
                <input id="nmTipo_Plan"
                       asp-for="@Model.Actual!.Tipo_Plan" />
                <br />
                <label>
                    Fecha_Inicio
                </label>
                <input id="nmFecha_Inicio"
                       asp-for="@Model.Actual!.Fecha_Inicio" />
                <br />
                <label>
                    Fecha_Fin
                </label>
                <input id="nmFecha_Fin"
                       asp-for="@Model.Actual!.Fecha_Fin" />
                <br />
                
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Suscripcion con información
                        @Model.Actual!.Usuario,
                        @Model.Actual!.Tipo_Plan
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Usuario</th>
                        <th>Tipo de Plan</th>
                        <th>Fecha de Inicio</th>
                        <th>Fecha de Fin</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._Usuario!.Nombre</td>
                                <td>@elemento.Tipo_Plan!</td>
                                <td>@elemento.Fecha_Inicio</td>
                                <td>@elemento.Fecha_Fin</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>