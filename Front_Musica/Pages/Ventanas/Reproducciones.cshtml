@page
@model ReproduccionesModel
@{
    ViewData["Title"] = "Reproducciones";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Reproducciones</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar"/>
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo"/>
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar"/>
            <input id="flUsuario"
                   placeholder="Usuario"
                   asp-for="@Model.Filtro!.Usuario"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Reproduccion</h3>

                <label>
                    Usuario
                </label>
                <input id="nmUsuario"
                       asp-for="@Model.Actual!.Usuario" />
                <br />

                <label>
                    Cancion
                </label>
                <input id="nmCancion"
                       asp-for="@Model.Actual!.Cancion" />
                <br />

                <label>
                    Fecha_Hora
                </label>
                <input id="nmFecha_Hora"
                       asp-for="@Model.Actual!.Fecha_Hora" />
                <br />

                <label>
                    Duracion
                </label>
                <input id="nmDuracion"
                       asp-for="@Model.Actual!.Duracion" />
                <br />
              
            </div>
        }
        
        @if (Model.Nuevo)
        {
            <div>
                <h3>Reproduccion</h3>
                <label>
                    Usuario
                </label>
                <input id="nmUsuario"
                       asp-for="@Model.Actual!.Usuario" />
                 <label>
                    Cancion
                </label>
                <input id="nmCancion"
                       asp-for="@Model.Actual!.Cancion" />
                <br />

                <label>
                    Fecha_Hora
                </label>
                <input id="nmFecha_Hora"
                       asp-for="@Model.Actual!.Fecha_Hora" />
                <br />

                <label>
                    Duracion
                </label>
                <input id="nmDuracion"
                       asp-for="@Model.Actual!.Duracion" />
                <br />
              
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Reproduccion con información
                        @Model.Actual!.Usuario,
                        @Model.Actual!.Cancion
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Usuario</th>
                        <th>Cancion</th>
                        <th>Fecha y Hora</th>
                        <th>Duracion</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>
                                </td>
                                <td>@elemento.Usuario</td>
                                <td>@elemento.Cancion</td>
                                <td>@elemento.Fecha_Hora</td>
                                <td>@elemento.Duracion</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>