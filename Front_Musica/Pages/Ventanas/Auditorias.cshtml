@page
@model AuditoriasModel
@{
    ViewData["Title"] = "Auditorias";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Auditorias</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
            <input id="flAccion"
                   placeholder="Accion"
                   asp-for="@Model.Filtro!.Accion" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Auditoria</h3>

                <label>
                    Accion
                </label>
                <input id="nmAccion"
                       asp-for="@Model.Actual!.Accion" />
                <br />

                <label>
                    Usuario
                </label>
                <input id="nmUsuario"
                       asp-for="@Model.Actual!.Usuario" />
                <br />

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                       asp-for="@Model.Actual!.Fecha" />
            </div>
        }

        @if (Model.Nuevo)
        {
            <div>
                <h3>Auditoria</h3>
                <label>
                    Accion
                </label>
                <input id="nmAccion"
                       asp-for="@Model.Actual!.Accion" />
                <br />
                <label>
                    Usuario
                </label>
                <input id="nmUsuario"
                       asp-for="@Model.Actual!.Usuario" />
                <br />
                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                       asp-for="@Model.Actual!.Fecha" />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la auditoria con información
                        @Model.Actual!.Accion,
                        @Model.Actual!.Fecha
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Accion</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Fecha</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Accion</td>
                                <td>@elemento._Usuario?.Nombre</td>
                                <td>@elemento._Usuario?.Correo</td>
                                <td>@elemento.Fecha</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>