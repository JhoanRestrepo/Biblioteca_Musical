@page
@model Canciones_IdiomasModel
@{
    ViewData["Title"] = "Canciones_Idiomas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Canciones_Idiomas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar"/>
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo"/>
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar"/>
            <input id="flCanciones"
                   placeholder="Cancion"
                   asp-for="@Model.Filtro!._Cancion!.Titulo" />
            <input id="flIdiomas"
                   placeholder="Idioma"
                   asp-for="@Model.Filtro!._Idioma!.Nombre" />
        </div>

        @if (Model.Nuevo)
        {
            <div>
                <h3>Cancion_Idioma</h3>
                <label>
                    Cancion
                </label>
                <input id="nmCancion"
                       asp-for="@Model.Actual!.Cancion" />
                <br />
                <label>
                    Idioma
                </label>
                <input id="nmIdioma"
                       asp-for="@Model.Actual!.Idioma" />
                <br />
                <label>
                    Porcentaje
                </label>
                <input id="nmPorcentaje"
                       asp-for="@Model.Actual!.Porcentaje" />
                <br />
                <label>
                    Fecha_Registro
                </label>
                <input id="nmFecha_Registro"
                       asp-for="@Model.Actual!.Fecha_Registro" />
            </div>
        }

        

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Cancion</h3>
                <select id="nm_Cancion"
                        class="form-control"
                        asp-for="@Model.Actual!.Cancion!"
                        asp-items="@(new SelectList(Model.Canciones!, "Id", "Titulo"))">
                </select>
                <br />
                <h3>Idioma</h3>
                <select id="nm_Idioma"
                        class="form-control"
                        asp-for="@Model.Actual!.Idioma!"
                        asp-items="@(new SelectList(Model.Idiomas!, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Porcentaje
                </label>
                <input id="nmPorcentaje"
                       asp-for="@Model.Actual!.Porcentaje" />
                <br />

                <label>
                    Fecha_Registro
                </label>
                <input id="nmFecha_Registro"
                       asp-for="@Model.Actual!.Fecha_Registro" />

                <p> Total canciones: @Model.Canciones?.Count() </p>
                <p> Total idiomas: @Model.Idiomas?.Count() </p>
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la cancion_idioma con información
                        @Model.Actual!._Cancion,
                        @Model.Actual!._Idioma
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cancion</th>
                        <th>Idioma</th>
                        <th>Porcentaje</th>
                        <th>Fecha_Registro</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._Cancion!.Titulo</td>
                                <td>@elemento._Idioma!.Nombre</td>
                                <td>@elemento.Porcentaje</td>
                                <td>@elemento.Fecha_Registro?.Year</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>