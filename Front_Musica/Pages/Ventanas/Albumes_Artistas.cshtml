@page
@model Albumes_ArtistasModel
@{
    ViewData["Title"] = "Albumes_Artistas";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Albumes_Artistas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar"/>
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo"/>
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar"/>
            <input id="flAlbumes"
                   placeholder="Album"
                   asp-for="@Model.Filtro!._Album!.Titulo" />
            <input id="flArtistas"
                   placeholder="Artista"
                   asp-for="@Model.Filtro!._Artista!.Nombre" />
        </div>

        @if (Model.Nuevo)
        {
            <div>
                <h3>Album</h3>
                <label>
                    Albumes
                </label>
                <input id="nmAlbumes"
                       asp-for="@Model.Actual!.Album" />
                <br />
                <label>
                    Artista
                </label>
                <input id="nmArtista"
                       asp-for="@Model.Actual!.Artista" />
            </div>
        }

        

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Album</h3>
                <select id="nm_Album"
                        class="form-control"
                        asp-for="@Model.Actual!._Album!.Id"
                        asp-items="@(new SelectList(Model.Albumes!, "Id", "Titulo"))">
                </select>
                <br />
                <h3>Artista</h3>
                <select id="nm_Artista"
                        class="form-control"
                        asp-for="@Model.Actual!._Artista!.Nombre"
                        asp-items="@(new SelectList(Model.Artistas!, "Id", "Nombre"))">
                </select>

                <p> Total álbumes: @Model.Albumes?.Count() </p>
                <p> Total artistas: @Model.Artistas?.Count() </p>
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el album con información
                        @Model.Actual!._Artista,
                        @Model.Actual!._Album
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Artista</th>
                        <th>Albumes</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._Artista!.Nombre</td>
                                <td>@elemento._Album!.Titulo</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>