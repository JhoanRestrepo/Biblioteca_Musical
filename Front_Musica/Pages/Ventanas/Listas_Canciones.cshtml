@page
@model Listas_CancionesModel
@{
    ViewData["Title"] = "Listas_Canciones";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Listas_Canciones</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar"/>
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo"/>
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar"/>
            <input id="flCancion"
                   placeholder="Cancion"
                   asp-for="@Model.Filtro!._Cancion.Titulo"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Cancion</h3>
                <select id="nm_Cancion"
                        class="form-control"
                        asp-for="@Model.Actual!.Cancion!"
                        asp-items="@(new SelectList(Model.Canciones!, "Id", "Titulo"))">
                </select>
                <br />
                <label>
                    Posicion
                </label>
                <input id="nmPosiscion"
                       asp-for="@Model.Actual!.Posicion" />
                <br />
                <label>
                    Fecha_Agregada
                </label>
                <input id="nmFecha_Agregada"
                       asp-for="@Model.Actual!.Fecha_Agregada" />
                <br />
                <h3>Favorita</h3>
                <select id="nm_Favorita"
                        class="form-control"
                        asp-for="@Model.Actual!.Favorita!"
                        asp-items="@(new SelectList(Model.Favoritos!, "Id", "Activo"))">
                </select>
                <br />

                
            </div>
        }
        
        @if (Model.Nuevo)
        {
            <div>
                <h3>Lista_Cancion</h3>
                <label>
                    Cancion
                </label>
                <input id="nmCancion"
                       asp-for="@Model.Actual!.Cancion" />
                <br />
                <label>
                    Posicion
                </label>
                <input id="nmPosiscion"
                       asp-for="@Model.Actual!.Posicion" />
                <br />
                <label>
                    Fecha_Agregada
                </label>
                <input id="nmFecha_Agregada"
                       asp-for="@Model.Actual!.Fecha_Agregada" />
                <br />
                <label>
                    Favorita
                </label>
                <input id="nmFavorita"
                       asp-for="@Model.Actual!.Favorita" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Lista_Cancion con información
                        @Model.Actual!._Cancion,
                        @Model.Actual!.Fecha_Agregada
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cancion</th>
                        <th>Posicion</th>
                        <th>Fecha Agregada</th>
                        <th>Favorita</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._Cancion!.Titulo</td>
                                <td>@elemento.Posicion</td>
                                <td>@elemento.Fecha_Agregada</td>
                                <td>@elemento._Favorita!.Activo</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>