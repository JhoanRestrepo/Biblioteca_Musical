@page
@model Usuarios_RolesModel
@{
    ViewData["Title"] = "Usuarios_Roles";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Usuarios_Roles</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar"/>
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo"/>
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar"/>
            <input id="flUsuario_Roles"
                   placeholder="Usuario_Rol"
                   asp-for="@Model.Filtro!._Usuario!.Titulo" />
            <input id="flArtistas"
                   placeholder="Artista"
                   asp-for="@Model.Filtro!._Rol!.Nombre" />
        </div>

        @if (Model.Nuevo)
        {
            <div>
                <h3>Usuario_Rol</h3>
                <label>
                    Usuario
                </label>
                <input id="nmUsuario"
                       asp-for="@Model.Actual!.Usuario" />
                <br />
                <label>
                    Rol
                </label>
                <input id="nmRol"
                       asp-for="@Model.Actual!.Rol" />
            </div>
        }

        

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            ;
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Usuario</h3>
                <select id="nm_Usuario"
                        class="form-control"
                        asp-for="@Model.Actual!.Usuario!"
                        asp-items="@(new SelectList(Model.Usuarios!, "Id", "Nombre"))">
                </select>
                <br />
                <h3>Rol</h3>
                <select id="nm_Rol"
                        class="form-control"
                        asp-for="@Model.Actual!.Rol!"
                        asp-items="@(new SelectList(Model.Roles!, "Id", "Nombre"))">
                </select>

                <p> Total usuarios: @Model.Usuarios?.Count() </p>
                <p> Total roles: @Model.Roles?.Count() </p>
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar el Usuario_Rol con información
                        @Model.Actual!._Rol,
                        @Model.Actual!._Usuario
                    </h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._Usuario!.Nombre</td>
                                <td>@elemento._Rol!.Nombre</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>